# ==============================================================================
# CIC Enugu 1995 Alumni Association Portal (.gitignore)
# Project: CIC-ENUGU-25-SET
# ==============================================================================

# -------------------------------------------------------------
# Dependencies
# -------------------------------------------------------------
node_modules/
*/node_modules/
.pnp
.pnp.js

# -------------------------------------------------------------
# Environment & Secrets (NEVER COMMIT SENSITIVE KEYS)
# -------------------------------------------------------------
.env
.env.*
!.env.example
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# -------------------------------------------------------------
# Database Files & SQLite Engine
# -------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
prisma/dev.db
prisma/dev.db-journal
server/prisma/dev.db
server/prisma/dev.db-journal

# -------------------------------------------------------------
# Uploaded User & Secretariat Media
# (Ignore uploaded images but keep uploads/ directory via .gitkeep)
# -------------------------------------------------------------
uploads/*
server/uploads/*
!uploads/.gitkeep
!server/uploads/.gitkeep

# -------------------------------------------------------------
# Runtime Logs & Diagnostic Output
# -------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# -------------------------------------------------------------
# Editor & IDE Directories
# -------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# -------------------------------------------------------------
# Operating System Artifacts
# -------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# -------------------------------------------------------------
# Build, Cloud & Deployment Outputs
# -------------------------------------------------------------
dist/
build/
.cache/
.vercel/
.output/
coverage/
.nyc_output/

# Temporary / Scratch artifacts
scratch/
