# Server Environment Configuration
PORT=5050
NODE_ENV=development
API_PREFIX=/api

# Database Connection (Prisma)
# Default is SQLite for zero-config local development:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL, set schema.prisma provider to "postgresql" and uncomment below:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/cic_alumni?schema=public"

# Authentication & Security
# Change this secret in production!
JWT_SECRET="cic-enugu-1995-super-secret-jwt-key-2026-production"
JWT_EXPIRES_IN="7d"
COOKIE_SECRET="cic-enugu-cookie-secret-key-1995"
COOKIE_SECURE="false" # set to "true" in production behind HTTPS
CORS_ORIGIN="http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080"

# Initial Super Admin Seed Credentials
ADMIN_NAME="Secretariat SuperAdmin"
ADMIN_EMAIL="admin@cicalumni1995.org"
ADMIN_PASSWORD="cicEnuguAdmin1995!"
ADMIN_PIN="1995"

# Paystack API Keys (Payment Processing)
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_BASE_URL="https://api.paystack.co"

# Cloudinary Storage (Optional - falls back to local disk storage if empty)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
